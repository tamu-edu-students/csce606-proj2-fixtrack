<h1>Equipment</h1>
<%= render "messages" %>
<%= form_with url: equipment_index_path, method: :get, local: true, data: { turbo: false }, role: "search" do |form| %>
  <%= form.label :q, "Search equipment" %>
  <%= form.search_field :q, value: @query, placeholder: "Name or asset identifier" %>
  <%= form.submit "Search" %>
  <%= link_to "Clear search", equipment_index_path %>
<% end %>
<% if EquipmentPolicy.new(current_user, Equipment).create? %>
  <p><%= link_to "Add equipment", new_equipment_path %></p>
<% end %>
<% if @equipment.empty? %>
  <% if @query.present? %>
    <p role="status">No equipment matches your search.</p>
  <% else %>
    <p>No equipment has been registered.</p>
  <% end %>
<% else %>
  <table>
    <caption>Registered equipment and current status</caption>
    <thead><tr><th scope="col">Name</th><th scope="col">Asset identifier</th><th scope="col">Location</th><th scope="col">Status</th></tr></thead>
    <tbody>
      <% @equipment.each do |item| %>
        <tr>
          <td><%= link_to item.name, equipment_path(item) %></td>
          <td><%= item.asset_identifier %></td>
          <td><%= item.location %></td>
          <td><%= item.status %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
