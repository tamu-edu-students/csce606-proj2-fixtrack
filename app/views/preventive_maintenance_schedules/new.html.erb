<h1>Schedule preventive maintenance for <%= @equipment.name %></h1>
<p>Asset identifier: <%= @equipment.asset_identifier %></p>
<p>Task and due date are required. Choose a due date after today (<%= Date.current.iso8601 %>).</p>

<% if @schedule.errors.any? %>
  <div role="alert">
    <p>Please correct the following errors:</p>
    <ul>
      <% @schedule.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @schedule, url: equipment_preventive_maintenance_schedules_path(@equipment), local: true, data: { turbo: false } do |form| %>
  <p>
    <%= form.label :task, "Task" %>
    <%= form.text_field :task, required: true, aria: { invalid: @schedule.errors[:task].any?, describedby: "task-errors" } %>
    <span id="task-errors"><%= @schedule.errors.full_messages_for(:task).to_sentence %></span>
  </p>
  <p>
    <%= form.label :due_date, "Due date" %>
    <%= form.date_field :due_date, required: true, min: Date.tomorrow.iso8601, aria: { invalid: @schedule.errors[:due_date].any?, describedby: "due-date-errors" } %>
    <span id="due-date-errors"><%= @schedule.errors.full_messages_for(:due_date).to_sentence %></span>
  </p>
  <%= form.submit "Save schedule" %>
<% end %>

<p><%= link_to "Cancel", equipment_preventive_maintenance_schedules_path(@equipment) %></p>
