<section class="ticket-details" aria-labelledby="ticket-details-title">
  <h1 id="ticket-details-title"><%= ticket.title %></h1>

  <dl>
    <dt>Ticket ID</dt>
    <dd><%= ticket.id %></dd>

    <dt>Equipment</dt>
    <dd><%= ticket.equipment.name %></dd>

    <dt>Equipment Identifier</dt>
    <dd><%= ticket.equipment.asset_identifier %></dd>

    <dt>Issue Description</dt>
    <dd><%= ticket.description %></dd>

    <dt>Priority</dt>
    <dd><%= ticket.priority.to_s.humanize %></dd>

    <dt>Status</dt>
    <dd><%= ticket.status.to_s.humanize %></dd>

    <dt>Reported By</dt>
    <dd><%= ticket.reporter.name %></dd>

    <dt>Created</dt>
    <dd><%= ticket.created_at&.to_fs(:long) %></dd>

    <dt>Last Updated</dt>
    <dd><%= ticket.updated_at&.to_fs(:long) %></dd>
  </dl>
</section>
